<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KouTube" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/yt_dark</item>
        <!-- MIUI "force dark" repaints Compose colours (white text on a white button); we draw our own dark theme -->
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/yt_dark</item>
    </style>
</resources>
