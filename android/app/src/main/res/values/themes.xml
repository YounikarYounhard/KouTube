<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the window theme only sets the colour you see while it starts -->
    <style name="Theme.KouTube" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <!-- MIUI "force dark" repaints Compose colours (white text on a white button); we draw our own dark theme -->
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/white</item>
    </style>
</resources>
