<Window x:Class="KouTube.PickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подборка" Icon="koutube.ico" Width="1140" Height="780" MinWidth="860" MinHeight="600" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="X" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#CC000000" CornerRadius="14" Width="28" Height="28">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FF0000" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Red" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FF0000" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" /></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#CC0000" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PickCard">
            <Grid Width="250" Margin="0,0,14,18">
                <StackPanel>
                    <Grid Width="250" Height="141">
                        <Grid.Clip><RectangleGeometry Rect="0,0,250,141" RadiusX="10" RadiusY="10" /></Grid.Clip>
                        <Rectangle Fill="#272727" />
                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Background="#CC000000" CornerRadius="4" Padding="4,1">
                            <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                    <TextBlock Opacity="0.7" FontSize="12.5"><Run Text="{Binding Channel, Mode=OneWay}" /> · <Run Text="{Binding SizeText, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="{Binding Reason}" Opacity="0.55" FontSize="12" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                    <Button Style="{StaticResource X}" Content="&#xE890;" Tag="{Binding}" Click="OnSeenPick" Margin="0,0,6,0"
                            ToolTip="Уже смотрел на YouTube — больше не предлагать. На рекомендации не влияет" />
                    <Button Style="{StaticResource X}" Content="&#xE711;" Tag="{Binding}" Click="OnRemovePick"
                            ToolTip="Убрать — на его место встанет следующее. На рекомендации не влияет" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PickShort">
            <Grid Width="150" Height="267" Margin="0,0,12,16">
                <Grid.Clip><RectangleGeometry Rect="0,0,150,267" RadiusX="10" RadiusY="10" /></Grid.Clip>
                <Rectangle Fill="#272727" />
                <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                <Border VerticalAlignment="Bottom" Padding="8,20,8,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0" /><GradientStop Color="#CC000000" Offset="1" /></LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                    <Button Style="{StaticResource X}" Content="&#xE890;" Tag="{Binding}" Click="OnSeenPick" Margin="0,0,6,0"
                            ToolTip="Уже смотрел на YouTube — больше не предлагать. На рекомендации не влияет" />
                    <Button Style="{StaticResource X}" Content="&#xE711;" Tag="{Binding}" Click="OnRemovePick"
                            ToolTip="Убрать — на его место встанет следующее. На рекомендации не влияет" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="28,18,28,18">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,18">
            <TextBlock x:Name="Step1" Text="1  Что смотреть" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="   ›   " FontSize="16" Opacity="0.35" />
            <TextBlock x:Name="Step2" Text="2  Сколько места" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="   ›   " FontSize="16" Opacity="0.35" />
            <TextBlock x:Name="Step3" Text="3  Подборка" FontSize="16" FontWeight="SemiBold" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button x:Name="BackBtn" Content="Назад" DockPanel.Dock="Left" Click="OnBack" Padding="18,6" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Click="OnCancel" Padding="18,6" />
                <Button x:Name="NextBtn" Content="Далее" Margin="10,0,0,0" Padding="24,8" Click="OnNext" Foreground="White" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#FF0000" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" /></Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#CC0000" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </DockPanel>

        <Grid>
            <!-- 1: what to look for -->
            <ScrollViewer x:Name="P1" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="940" HorizontalAlignment="Left">
                    <Border x:Name="AgainBox" Background="#14FFFFFF" CornerRadius="10" Padding="14,12" Margin="0,0,0,18" Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="AgainBtn" Style="{StaticResource Red}" DockPanel.Dock="Right" Content="Как в прошлый раз" Padding="22,8" Click="OnAgain" VerticalAlignment="Center" />
                            <TextBlock x:Name="AgainText" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Center" Margin="0,0,14,0" />
                        </DockPanel>
                    </Border>
                    <Border x:Name="ImplicitText_Box" Background="#14FFFFFF" CornerRadius="10" Padding="14,10" Margin="0,0,0,18">
                        <TextBlock x:Name="ImplicitText" TextWrapping="Wrap" FontSize="14" />
                    </Border>
                    <TextBlock Text="Каналы" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Новые видео этих каналов попадут в подборку. Напишите имя канала, @handle или вставьте ссылку на канал — он запомнится." Opacity="0.7" Margin="0,4,0,8" TextWrapping="Wrap" />
                    <WrapPanel x:Name="ChannelChips" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox x:Name="ChannelQuery" Width="400" Height="34" VerticalContentAlignment="Center" KeyDown="OnChannelKey" />
                        <Button x:Name="FindBtn" Content="Найти канал" Margin="8,0,0,0" Click="OnFindChannel" />
                    </StackPanel>
                    <StackPanel x:Name="ChannelResults" Margin="0,6,0,0" />

                    <TextBlock Text="Конкретные видео" FontSize="22" FontWeight="SemiBold" Margin="0,26,0,0" />
                    <TextBlock Text="Вставьте ссылки на видео или Shorts (можно сразу несколько) — они точно попадут в подборку, а остальное место заполнится само." Opacity="0.7" Margin="0,4,0,8" TextWrapping="Wrap" />
                    <WrapPanel x:Name="WantedChips" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox x:Name="WantedBox" Width="400" Height="34" VerticalContentAlignment="Center" KeyDown="OnWantedKey" />
                        <Button x:Name="WantedBtn" Content="Добавить" Margin="8,0,0,0" Click="OnAddWanted" />
                    </StackPanel>
                    <TextBlock x:Name="WantedStatus" Opacity="0.7" Margin="0,6,0,0" />

                    <TextBlock Text="Ключевые слова" FontSize="22" FontWeight="SemiBold" Margin="0,26,0,0" />
                    <TextBlock Text="KouTube поищет на YouTube видео на эти темы." Opacity="0.7" Margin="0,4,0,8" />
                    <WrapPanel x:Name="KeywordChips" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox x:Name="KeywordBox" Width="400" Height="34" VerticalContentAlignment="Center" KeyDown="OnKeywordKey" />
                        <Button Content="Добавить" Margin="8,0,0,0" Click="OnAddKeyword" />
                    </StackPanel>
                    <TextBlock x:Name="SuggestTitle" Text="Подсказки — из того, что вы смотрите:" Opacity="0.7" Margin="0,12,0,6" />
                    <WrapPanel x:Name="Suggestions" />

                    <TextBlock Text="Насколько свежие" FontSize="22" FontWeight="SemiBold" Margin="0,26,0,8" />
                    <RadioButton x:Name="AgeAny" Content="Любые" GroupName="age" Margin="0,3" />
                    <RadioButton x:Name="AgeNew" Content="Только новые — за последние 2 недели" GroupName="age" Margin="0,3" />
                    <RadioButton x:Name="AgeSettled" Content="Не свежее 3 дней — SponsorBlock успеет разметить рекламу" GroupName="age" Margin="0,3" />
                </StackPanel>
            </ScrollViewer>

            <!-- 2: how much space -->
            <StackPanel x:Name="P2" Visibility="Collapsed" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Text="Куда качать" FontSize="22" FontWeight="SemiBold" />
                <ComboBox x:Name="Target" DisplayMemberPath="Name" Width="340" HorizontalAlignment="Left" Margin="0,8,0,4" SelectionChanged="OnTarget" />
                <TextBlock x:Name="SpaceInfo" Opacity="0.7" TextWrapping="Wrap" />

                <TextBlock Text="Сколько места занять новыми видео" FontSize="22" FontWeight="SemiBold" Margin="0,30,0,4" />
                <TextBlock x:Name="TotalText" FontSize="40" FontWeight="Bold" />
                <Slider x:Name="Total" Minimum="0" Maximum="100" Width="720" HorizontalAlignment="Left" ValueChanged="OnSliders" SmallChange="1" LargeChange="5" />

                <TextBlock Text="Как поделить" FontSize="22" FontWeight="SemiBold" Margin="0,30,0,8" />
                <Grid Width="720" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Видео" FontSize="15" Opacity="0.75" />
                        <TextBlock x:Name="VideoText" FontSize="24" FontWeight="Bold" />
                    </StackPanel>
                    <Slider x:Name="Split" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="12,0" ValueChanged="OnSliders" />
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="Shorts" FontSize="15" Opacity="0.75" HorizontalAlignment="Right" />
                        <TextBlock x:Name="ShortText" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Ползунок вправо — больше места для Shorts, влево — для обычных видео." Opacity="0.6" Margin="0,8,0,0" />
            </StackPanel>

            <!-- 3: the picks -->
            <DockPanel x:Name="P3" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock x:Name="PickStatus" Opacity="0.75" />
                    <ProgressBar x:Name="PickProgress" IsIndeterminate="True" Height="3" Margin="0,6,0,0" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="VideosHeader" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <ItemsControl x:Name="VideoPicks" ItemTemplate="{StaticResource PickCard}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="ShortsHeader" FontSize="22" FontWeight="SemiBold" Margin="0,14,0,10" />
                        <ItemsControl x:Name="ShortPicks" ItemTemplate="{StaticResource PickShort}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
