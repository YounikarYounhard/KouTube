<Window x:Class="KouTube.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KouTube" Icon="koutube.ico" Width="1360" Height="860" MinWidth="980" MinHeight="620"
        Loaded="OnLoaded" Closing="OnClosing">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- cards: no list-selection chrome, just a soft hover like YouTube -->
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel /></ItemsPanelTemplate>

        <Style x:Key="RedButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FF0000" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#CC0000" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a video: 16:9 cover with duration and red progress, then avatar · title · channel -->
        <DataTemplate x:Key="VideoCard">
            <StackPanel Width="300" Margin="0,0,0,8">
                <Grid Width="300" Height="169">
                    <Grid.Clip><RectangleGeometry Rect="0,0,300,169" RadiusX="12" RadiusY="12" /></Grid.Clip>
                    <Rectangle Fill="#272727" />
                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Background="#CC000000" CornerRadius="4" Padding="4,1">
                        <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="#CC000000" CornerRadius="4" Padding="5,1" Visibility="{Binding BadgeVisible}">
                        <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Grid VerticalAlignment="Bottom" Height="4" Visibility="{Binding ProgressVisible}">
                        <Rectangle Fill="#99717171" />
                        <Rectangle Fill="Red" HorizontalAlignment="Left" Width="{Binding ProgressWidth}" />
                    </Grid>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid Width="36" Height="36" VerticalAlignment="Top">
                        <Ellipse Fill="{Binding AvatarColor}" />
                        <TextBlock Text="{Binding Letter}" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Visibility="{Binding AvatarVisible}">
                            <Ellipse.Fill><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" /></Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,4,0">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Channel}" FontSize="12.5" Opacity="0.7" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Sub}" FontSize="12.5" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- a Short: tall cover with the title over it -->
        <DataTemplate x:Key="ShortCard">
            <Grid Width="180" Height="320">
                <Grid.Clip><RectangleGeometry Rect="0,0,180,320" RadiusX="12" RadiusY="12" /></Grid.Clip>
                <Rectangle Fill="#272727" />
                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                <Border VerticalAlignment="Bottom" Padding="10,24,10,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0" /><GradientStop Color="#CC000000" Offset="1" /></LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                </Border>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="#CC000000" CornerRadius="4" Padding="5,1" Visibility="{Binding BadgeVisible}">
                    <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                </Border>
                <Grid VerticalAlignment="Bottom" Height="4" Visibility="{Binding ProgressVisible}">
                    <Rectangle Fill="Red" HorizontalAlignment="Left" Width="{Binding ShortProgressWidth}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <ContextMenu x:Key="CardMenu">
            <MenuItem Header="Открыть" Click="OnOpenVideo" />
            <MenuItem Header="Показать в проводнике" Click="OnShowInExplorer" />
            <Separator />
            <MenuItem Header="Скачать снова" Click="OnRedownload" />
            <MenuItem Header="Больше не предлагать" Click="OnNeverAgain" />
        </ContextMenu>

        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="#272727" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="#F1F1F1" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F1F1" />
                                <Setter TargetName="T" Property="Foreground" Value="#0F0F0F" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <!-- header: logo · search · the big red button -->
        <Grid Grid.ColumnSpan="2" Margin="18,10,18,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource YtRedBrush}" CornerRadius="7" Width="34" Height="24">
                    <Path Data="M0,0 L10,6 L0,12 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                </Border>
                <TextBlock Text="KouTube" FontSize="22" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Grid Grid.Column="1" MaxWidth="560">
                <TextBox x:Name="Search" Height="38" VerticalContentAlignment="Center" Padding="36,0,0,0" TextChanged="OnFilter" ToolTip="Поиск по названию, каналу, категории" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="15" Opacity="0.6" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="Поиск" Opacity="0.5" VerticalAlignment="Center" Margin="38,0,0,0" IsHitTestVisible="False" />
            </Grid>
            <Button Grid.Column="2" Click="OnPick" Padding="20,9" Style="{StaticResource RedButton}" ToolTip="Подобрать новые видео и Shorts под свободное место">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" />
                    <TextBlock Text="Подборка" Margin="8,0,0,0" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- left menu -->
        <ListBox x:Name="Nav" Grid.Row="1" Margin="8,6,8,0" SelectedIndex="0" SelectionChanged="OnNav" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavItem}">
            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="{StaticResource Icons}" FontSize="18" /><TextBlock Text="Главная" Margin="16,0,0,0" FontSize="15" /></StackPanel></ListBoxItem>
            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B2;" FontFamily="{StaticResource Icons}" FontSize="18" /><TextBlock Text="Shorts" Margin="16,0,0,0" FontSize="15" /></StackPanel></ListBoxItem>
            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="{StaticResource Icons}" FontSize="18" /><TextBlock Text="История" Margin="16,0,0,0" FontSize="15" /></StackPanel></ListBoxItem>
            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="18" /><TextBlock x:Name="NavDownloads" Text="Загрузки" Margin="16,0,0,0" FontSize="15" /></StackPanel></ListBoxItem>
            <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="18" /><TextBlock Text="Настройки" Margin="16,0,0,0" FontSize="15" /></StackPanel></ListBoxItem>
        </ListBox>

        <Grid Grid.Row="1" Grid.Column="1" Margin="8,6,12,0">
            <!-- ============ home / history: video cards ============ -->
            <DockPanel x:Name="PageCards">
                <StackPanel DockPanel.Dock="Top" Margin="6,0,0,10">
                    <StackPanel x:Name="Chips" Orientation="Horizontal" />
                    <TextBlock x:Name="StorageText" Opacity="0.65" Margin="2,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Grid>
                    <ListBox x:Name="Cards" ItemTemplate="{StaticResource VideoCard}" ItemsPanel="{StaticResource Wrap}" ItemContainerStyle="{StaticResource CardItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent"
                             ContextMenu="{StaticResource CardMenu}" MouseDoubleClick="OnOpenVideo" />
                    <StackPanel x:Name="EmptyCards" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="&#xE8B2;" FontFamily="{StaticResource Icons}" FontSize="56" Opacity="0.5" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyText" FontSize="16" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
                        <StackPanel x:Name="EmptyBtn" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Button Content="Добавить флешку или папку" Click="OnAddStorage" />
                            <Button Content="Телефон по кабелю" Margin="8,0,0,0" Click="OnAddPhone" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </DockPanel>

            <!-- ============ downloads ============ -->
            <DockPanel x:Name="PageDownloads" Visibility="Collapsed">
                <!-- the summary: how many, how much, how fast, how long -->
                <Border DockPanel.Dock="Top" Background="#14FFFFFF" CornerRadius="14" Padding="20,16" Margin="6,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SumTitle" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Name="SumDetail" Opacity="0.75" Margin="0,4,0,10" FontSize="14" />
                            <ProgressBar x:Name="SumBar" Height="6" Maximum="100" Foreground="#FF0000" Background="#33FFFFFF" BorderThickness="0" />
                            <TextBlock x:Name="PlanText" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.7" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,0,0,0">
                            <Button x:Name="StopBtn" Content="Пауза" Click="OnStop" IsEnabled="False" Padding="18,7" />
                            <Button x:Name="RetryBtn" Content="Повторить ошибки" Click="OnRetry" Margin="8,0,0,0" Padding="18,7" Visibility="Collapsed" />
                            <Button x:Name="ConfirmBtn" Content="Скачать" Margin="8,0,0,0" Click="OnConfirm" Style="{StaticResource RedButton}" Padding="22,8" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid DockPanel.Dock="Top" Margin="6,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="Links" Height="36" VerticalContentAlignment="Center" TextChanged="OnLinksChanged" />
                        <TextBlock x:Name="LinksHint" Text="Ссылка на видео, Shorts, плейлист или канал" Opacity="0.45" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                    <ComboBox x:Name="Target" Grid.Column="1" Width="230" Margin="8,0,0,0" DisplayMemberPath="Name" ToolTip="Куда качать" SelectionChanged="OnTargetChanged" />
                    <Button x:Name="FindBtn" Grid.Column="2" Content="Добавить" Margin="8,0,0,0" Click="OnFind" />
                    <Button Grid.Column="3" Content="Убрать готовые" Margin="8,0,0,0" Click="OnClean" />
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="QueueList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6,0,6,10" Padding="12" CornerRadius="12" Background="#0DFFFFFF">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="176" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="Качать это видео" />
                                        <Grid Grid.Column="1" Width="160" Height="90" HorizontalAlignment="Left">
                                            <Grid.Clip><RectangleGeometry Rect="0,0,160,90" RadiusX="8" RadiusY="8" /></Grid.Clip>
                                            <Rectangle Fill="#272727" />
                                            <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5" Background="#CC000000" CornerRadius="4" Padding="4,0">
                                                <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="2" Margin="6,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Opacity="0.7" Margin="0,2,0,0"><Run Text="{Binding Channel, Mode=OneWay}" /> · <Run Text="{Binding Kind, Mode=OneWay}" /> · <Run Text="{Binding Size, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Text="{Binding Why}" Opacity="0.5" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,8,0,6" Foreground="{Binding StatusColor}" Background="#26FFFFFF" BorderThickness="0" />
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{Binding StatusColor}" CornerRadius="9" Padding="9,2">
                                                    <TextBlock Text="{Binding Status}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding Detail}" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.85" TextWrapping="Wrap" MaxWidth="560" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Sb}" Opacity="0.55" FontSize="12" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <ComboBox ItemsSource="{Binding Variants}" SelectedItem="{Binding Selected, Mode=TwoWay}" DisplayMemberPath="Text" Width="210" ToolTip="Качество и формат" />
                                            <Button Content="Убрать" Margin="0,8,0,0" HorizontalAlignment="Right" Tag="{Binding}" Click="OnRemoveRow" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- ============ settings ============ -->
            <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="6,0,20,20" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="Флешки, папки и телефоны" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Флешка, SD-карта, любая папка — или телефон по USB-кабелю (на телефоне выберите «Передача файлов»). Внутри появится служебная папка .koutube — сами видео не переименовываются и не перемещаются."
                               TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,8" />
                    <ListBox x:Name="StorageList" MinHeight="60" SelectionChanged="OnStorageSelected" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Добавить флешку или папку" Click="OnAddStorage" />
                        <Button Content="Телефон по кабелю" Margin="8,0,0,0" Click="OnAddPhone" />
                        <Button Content="Отключить выбранное" Margin="8,0,0,0" Click="OnRemoveStorage" />
                    </StackPanel>

                    <TextBlock Text="Место на выбранном носителе" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Всегда оставлять свободным для своих файлов" VerticalAlignment="Center" Width="330" />
                        <TextBox x:Name="ReserveGb" Width="80" />
                        <TextBlock Text="ГБ" VerticalAlignment="Center" Margin="6,0" />
                    </StackPanel>

                    <TextBlock Text="Качество" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Не выше" VerticalAlignment="Center" />
                        <ComboBox x:Name="MaxRes" Width="110" Margin="8,0" SelectedIndex="1">
                            <ComboBoxItem Content="480p" /><ComboBoxItem Content="720p" /><ComboBoxItem Content="1080p" />
                        </ComboBox>
                        <TextBlock Text="(вертикальные Shorts 720×1280 тоже считаются 720p)" VerticalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Форматы по порядку:" VerticalAlignment="Center" />
                        <CheckBox x:Name="CodecAv1" Content="AV1 (меньше всего)" Margin="10,0" />
                        <CheckBox x:Name="CodecVp9" Content="VP9" Margin="10,0" />
                        <CheckBox x:Name="CodecH264" Content="H.264 (самый совместимый)" Margin="10,0" />
                    </StackPanel>
                    <CheckBox x:Name="Fps60" Content="Разрешать 60 кадров/с" Margin="0,8,0,0" />
                    <TextBlock x:Name="CapsText" TextWrapping="Wrap" Opacity="0.7" Margin="0,6,0,0" />

                    <TextBlock Text="Субтитры" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Языки:" VerticalAlignment="Center" />
                        <TextBox x:Name="SubLangs" Width="160" Margin="8,0" />
                        <CheckBox x:Name="AutoSubs" Content="и автоматические, если нет обычных" />
                    </StackPanel>

                    <TextBlock Text="Реклама внутри видео (SponsorBlock) — что вырезать" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,6" />
                    <WrapPanel x:Name="SbPanel" />
                    <CheckBox x:Name="PreciseCuts" Content="Точные резы (перекодирует места около резов — медленнее)" Margin="0,8,0,0" />
                    <TextBlock Text="SponsorBlock знает только то, что разметили люди. У свежих роликов разметки часто ещё нет — их выгоднее качать через несколько дней."
                               TextWrapping="Wrap" Opacity="0.7" Margin="0,6,0,0" />

                    <TextBlock Text="Комментарии" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Скачивать самых популярных комментариев на видео:" VerticalAlignment="Center" />
                        <TextBox x:Name="CommentsN" Width="80" Margin="8,0" />
                        <TextBlock Text="(0 — не качать, максимум 1000; весят копейки)" VerticalAlignment="Center" Opacity="0.7" />
                    </StackPanel>

                    <TextBlock Text="Прочее" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Временная папка загрузок:" VerticalAlignment="Center" />
                        <TextBox x:Name="TempDir" Width="420" Margin="8,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Обновить yt-dlp" Click="OnUpdateYtDlp" />
                        <TextBlock x:Name="ToolsText" VerticalAlignment="Center" Margin="10,0" Opacity="0.7" />
                    </StackPanel>
                    <Button Content="Сохранить настройки" Margin="0,24,0,0" HorizontalAlignment="Left" Click="OnSaveSettings" Style="{DynamicResource AccentButtonStyle}" Padding="18,6" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="18,6">
            <TextBlock x:Name="StatusText" Text="Готово" TextTrimming="CharacterEllipsis" Opacity="0.75" />
        </Border>
    </Grid>
</Window>
