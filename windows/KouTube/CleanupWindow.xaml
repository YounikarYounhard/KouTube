<Window x:Class="KouTube.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотренные видео" Icon="koutube.ico" Width="1000" Height="700" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="28,20,28,18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock x:Name="Header" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="Их можно убрать и закачать на освободившееся место новые. Снимите галочку с того, что хотите оставить. Карточки и история останутся."
                       Opacity="0.7" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button Content="Не сейчас" DockPanel.Dock="Left" Click="OnLater" Padding="18,7" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OnlyDelete" Content="Только удалить" Click="OnDelete" Padding="18,7" />
                <Button x:Name="DeleteAndPick" Margin="10,0,0,0" Padding="24,8" Click="OnDeleteAndPick" Foreground="White" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#FF0000" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" /></Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#CC0000" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="DeleteAndPickText" FontWeight="SemiBold" />
                </Button>
            </StackPanel>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="210" Margin="0,0,14,16">
                            <Grid Width="210" Height="118">
                                <Grid.Clip><RectangleGeometry Rect="0,0,210,118" RadiusX="10" RadiusY="10" /></Grid.Clip>
                                <Rectangle Fill="#272727" />
                                <Image Source="{Binding Cover}" Stretch="UniformToFill" Opacity="{Binding CoverOpacity}" />
                                <CheckBox IsChecked="{Binding Delete, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="8" VerticalAlignment="Top" HorizontalAlignment="Left"
                                          ToolTip="Удалить" />
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Background="#CC000000" CornerRadius="4" Padding="4,1">
                                    <TextBlock Text="{Binding Size}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Channel}" Opacity="0.7" FontSize="12.5" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
