<Application x:Class="KouTube.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- YouTube red instead of the Windows accent colour -->
        <Color x:Key="YtRed">#FF0000</Color>
        <SolidColorBrush x:Key="YtRedBrush" Color="#FF0000" />
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF0000" />
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E60000" />
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC0000" />
        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF4E45" />
        <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FF4E45" />
        <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FF4E45" />
        <Color x:Key="SystemAccentColor">#FF0000</Color>
        <Color x:Key="SystemAccentColorLight1">#FF3333</Color>
        <Color x:Key="SystemAccentColorLight2">#FF4E45</Color>
        <Color x:Key="SystemAccentColorLight3">#FF8A80</Color>
        <Color x:Key="SystemAccentColorDark1">#E60000</Color>
        <Color x:Key="SystemAccentColorDark2">#CC0000</Color>
        <Color x:Key="SystemAccentColorDark3">#990000</Color>
    </Application.Resources>
</Application>
