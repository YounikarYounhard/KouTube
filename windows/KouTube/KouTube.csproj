<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>KouTube</AssemblyName>
    <Version>0.0.1</Version>
    <ApplicationIcon>koutube.ico</ApplicationIcon>
    <!-- WPF Fluent theme (ThemeMode) is still flagged experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- WPF leaves System.IO out of implicit usings (it clashes with Shapes.Path); nothing here uses Shapes -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="koutube.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediaDevices" Version="2.0.0" />
  </ItemGroup>

</Project>
